    "z": "tab-dashboard",
    "name": "Fmt Evaluation",
    "func": "var rows=msg.payload;\nif(!rows||!rows.length){msg.payload=[];return msg;}\nmsg.payload=rows.map(function(r){\n  var m=[];\n  if(r.rmse!=null)m.push({key:'RMSE',val:parseFloat(r.rmse).toFixed(4),good:parseFloat(r.rmse)<1.0,note:'menor=mejor'});\n  if(r.accuracy!=null)m.push({key:'Accuracy',val:(parseFloat(r.accuracy)*100).toFixed(1)+'%',good:parseFloat(r.accuracy)>0.6,note:''});\n  if(r.precision!=null)m.push({key:'Precision',val:(parseFloat(r.precision)*100).toFixed(1)+'%',good:parseFloat(r.precision)>0.6,note:''});\n  if(r.recall!=null)m.push({key:'Recall',val:(parseFloat(r.recall)*100).toFixed(1)+'%',good:parseFloat(r.recall)>0.7,note:''});\n  if(r.f1_score!=null)m.push({key:'F1',val:(parseFloat(r.f1_score)*100).toFixed(1)+'%',good:parseFloat(r.f1_score)>0.6,note:''});\n  return{model:(r.model||'').toUpperCase(),algorithm:r.algorithm||'',metrics:m};\n});\nreturn msg;",
