  {
    "id": "inject-refresh",
    "type": "inject",
    "z": "tab-dashboard",
    "name": "Actualizar cada 30s",
    "repeat": "30",
    "once": true,
    "onceDelay": "2",
    "payload": "{}",
    "payloadType": "json",
    "x": 130,
    "y": 60,
    "wires": [
      [
        "split-triggers"
      ]
    ]
  },
  {
    "id": "split-triggers",
    "type": "function",
    "z": "tab-dashboard",
    "name": "Distribuir triggers",
    "func": "var topics=['movies','users','ratings','ratings_realtime','recommendations_popular','recommendations_collab','recommendations_content','recommendations_classification','evaluation'];\ntopics.forEach(function(t){node.send({topic:t,payload:{}});});\nreturn null;",
    "outputs": 1,
    "x": 330,
    "y": 60,
    "wires": [
      [
        "route-query"
      ]
    ]
  },
  {
    "id": "route-query",
    "type": "function",
    "z": "tab-dashboard",
    "name": "Enrutar a colección",
    "func": "var t=msg.topic;\nif(t==='movies'){msg.collection='movies';msg.operation='count';msg.payload={};}\nelse if(t==='users'){msg.collection='users';msg.operation='count';msg.payload={};}\nelse if(t==='ratings'){msg.collection='ratings';msg.operation='count';msg.payload={};}\nelse if(t==='ratings_realtime'){msg.collection='ratings_realtime';msg.operation='count';msg.payload={};}\nelse if(t==='recommendations_popular'){msg.collection='recommendations';msg.operation='find';msg.payload={type:'popularity'};}\nelse if(t==='recommendations_collab'){msg.collection='recommendations';msg.operation='find';msg.payload={type:'collaborative'};}\nelse if(t==='recommendations_content'){msg.collection='recommendations';msg.operation='find';msg.payload={type:'content_based'};}\nelse if(t==='recommendations_classification'){msg.collection='recommendations';msg.operation='find';msg.payload={type:'classification'};}\nelse if(t==='evaluation'){msg.collection='model_metrics';msg.operation='find';msg.payload={};}\nreturn msg;",
    "outputs": 1,
    "x": 540,
    "y": 60,
    "wires": [
      [
        "mongo-query"
      ]
    ]
  },
  {
    "id": "mongo-query",
    "type": "mongodb in",
    "z": "tab-dashboard",
    "mongodb": "mongo-config",
    "name": "Consulta MongoDB",
    "collection": "",
    "operation": "find",
    "x": 750,
    "y": 60,
    "wires": [
      [
        "route-result"
      ]
    ]
  },
  {
    "id": "route-result",
    "type": "function",
    "z": "tab-dashboard",
    "name": "Distribuir resultados",
    "func": "var t=msg.topic;\nvar out=[null,null,null,null,null,null,null,null,null];\nif(t==='movies')out[0]=msg;\nelse if(t==='users')out[1]=msg;\nelse if(t==='ratings')out[2]=msg;\nelse if(t==='ratings_realtime')out[3]=msg;\nelse if(t==='recommendations_popular')out[4]=msg;\nelse if(t==='recommendations_collab')out[5]=msg;\nelse if(t==='recommendations_content')out[6]=msg;\nelse if(t==='recommendations_classification')out[7]=msg;\nelse if(t==='evaluation')out[8]=msg;\nreturn out;",
    "outputs": 9,
    "x": 960,
    "y": 60,
    "wires": [
      [
        "fmt-movies"
      ],
      [
        "fmt-users"
      ],
      [
        "fmt-ratings"
      ],
      [
        "fmt-realtime-cnt"
      ],
      [
        "fmt-popular"
      ],
      [
        "fmt-collab"
      ],
      [
        "fmt-content"
      ],
      [
        "fmt-classification"
      ],
      [
        "fmt-evaluation"
      ]
    ]
  },
