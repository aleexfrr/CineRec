  {
    "id": "fmt-popular",
    "type": "function",
    "z": "tab-dashboard",
    "name": "Fmt Popular",
    "func": "var rows=(msg.payload||[]).sort(function(a,b){return(b.average_rating||0)-(a.average_rating||0);}).slice(0,10);\nmsg.payload=rows.map(function(r){var v=parseFloat(r.average_rating)||0;return{title:r.title||'Sin título',rating:v.toFixed(2),pct:Math.round(v/5*100),votes:r.rating_count||0};});\nreturn msg;",
    "x": 1190,
    "y": 340,
    "wires": [
      [
        "tmpl-popular"
      ]
    ]
  },
  {
    "id": "tmpl-popular",
    "type": "ui_template",
    "z": "tab-dashboard",
    "group": "ui-group-popular",
    "order": 1,
    "width": "12",
    "height": "10",
    "format": "<style>.cr{display:flex;align-items:center;padding:7px 10px;border-bottom:1px solid #1a1a35;gap:8px}.cr:nth-child(odd){background:#0a0a1a}.cr:nth-child(even){background:#12122a}.crn{color:#a0a0c0;font-size:11px;min-width:18px;text-align:right;flex-shrink:0}.crt{flex:1;color:#f0f0f0;font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.crb{width:60px;background:#2a2a50;border-radius:3px;height:5px;flex-shrink:0}.crbf{height:5px;border-radius:3px;background:#f5c518}.crs{color:#f5c518;font-weight:700;font-size:13px;min-width:38px;text-align:right;flex-shrink:0}.crm{color:#a0a0c0;font-size:11px;min-width:55px;text-align:right;flex-shrink:0}</style><div style=\"background:#12122a;border-radius:8px;overflow:hidden;border:1px solid #2a2a50;\"><div style=\"padding:10px 12px;background:#1a1a35;color:#f5c518;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;border-bottom:1px solid #2a2a50;\">Top 10 — ordenadas por valoración media</div><div ng-repeat=\"item in msg.payload track by $index\" class=\"cr\"><span class=\"crn\">{{$index+1}}</span><span class=\"crt\" title=\"{{item.title}}\">{{item.title}}</span><div class=\"crb\"><div class=\"crbf\" ng-style=\"{'width':item.pct+'%'}\"></div></div><span class=\"crs\">{{item.rating}}</span><span class=\"crm\">{{item.votes}} votos</span></div><div ng-if=\"!msg.payload||!msg.payload.length\" style=\"padding:24px;color:#a0a0c0;text-align:center;\">Sin datos — ejecuta el recomendador de popularidad</div></div>",
    "storeOutMessages": true,
    "fwdInMessages": true,
    "resendOnRefresh": true,
    "templateScope": "local",
    "x": 1420,
    "y": 340,
    "wires": [
      []
    ]
  },
  {
    "id": "fmt-collab",
    "type": "function",
    "z": "tab-dashboard",
    "name": "Fmt Collab",
    "func": "var docs=msg.payload;\nif(!docs||!docs.length){msg.payload={header:'—',items:[]};return msg;}\nvar doc=docs[docs.length-1];\nvar items=(doc.recommendations||[]).map(function(r){var v=parseFloat(r.predicted_rating)||0;return{title:r.title,score:v.toFixed(2),pct:Math.round(v/5*100)};});\nmsg.payload={header:String(doc.userId||'—'),items:items};\nreturn msg;",
    "x": 1190,
    "y": 420,
    "wires": [
      [
        "tmpl-collab"
      ]
    ]
  },
