  {
    "id": "fmt-realtime",
    "type": "function",
    "z": "tab-dashboard",
    "name": "Fmt Realtime",
    "func": "var all=msg.payload||[];\nvar recent=all.slice(-20).reverse();\nvar avgRating=0;\nif(recent.length){\n  avgRating=recent.reduce(function(s,r){return s+(parseFloat(r.rating)||0);},0)/recent.length;\n}\nvar events=recent.map(function(r){\n  var ts=r.timestamp||r.ts||'';\n  if(ts&&typeof ts==='string'&&ts.length>16)ts=ts.substring(0,16).replace('T',' ');\n  var rating=parseFloat(r.rating)||0;\n  return{\n    userId:r.userId||r.user_id||'?',\n    movieId:r.movieId||r.movie_id||'?',\n    rating:rating.toFixed(1),\n    pct:Math.round(rating/5*100),\n    ts:ts\n  };\n});\nmsg.payload={stats:{total:all.length,avg:avgRating.toFixed(2)},events:events};\nreturn msg;",
    "x": 560,
    "y": 820,
    "wires": [
      [
        "tmpl-realtime"
      ]
    ]
  },
