    "func": "var docs=msg.payload;\nif(!docs||!docs.length){msg.payload={header:'—',items:[]};return msg;}\nvar doc=docs[docs.length-1];\nvar items=(doc.recommendations||[]).map(function(r){var v=parseFloat(r.similarity_score)||0;return{title:r.title,score:(v*100).toFixed(1)+'%',pct:Math.round(v*100)};});\nmsg.payload={header:String(doc.userId||'—'),items:items};\nreturn msg;",
